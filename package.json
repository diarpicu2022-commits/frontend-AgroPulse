{
  "name": "agropulse-frontend",
  "version": "10.0.0",
  "type": "module",
  "description": "AgroPulse — Dashboard Web y Móvil (TypeScript)",
  "private": true,
  "scripts": {
    "dev":     "vite --host",
    "build":   "tsc && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react":                  "^18.3.1",
    "react-dom":              "^18.3.1",
    "react-router-dom":       "^6.26.0",
    "@supabase/supabase-js":  "^2.45.0",
    "recharts":               "^2.12.7",
    "lucide-react":           "^0.446.0",
    "animejs":                "^3.2.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react":   "^4.3.1",
    "vite":                   "^5.4.3",
    "typescript":             "^5.5.4",
    "@types/react":           "^18.3.3",
    "@types/react-dom":       "^18.3.0",
    "@types/node":            "^22.5.0",
    "tailwindcss":            "^3.4.11",
    "autoprefixer":           "^10.4.20",
    "postcss":                "^8.4.45"
  }
}
